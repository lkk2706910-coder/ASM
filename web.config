<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- AI gateway. The api-key MUST NOT be committed to any source repo;
         fill it in only in the deployed web.config. -->
    <add key="AiGatewayUrl" value="http://10.11.197.97/openai/deployments/gpt-5.2/chat/completions" />
    <add key="AiApiKey" value="dc4bba06-7220-4246-a9f4-5f5a631939b1" />
    <add key="AiUserId" value="00041260" />
    <add key="AiSystemPrompt" value="你是 ASM 製程/設備工程師的中文 AI 助理。每則對話會附上「ASM TOOL 知識庫」與「目前頁面即時資料」,請務必依這些內容回答,並引用具體 EQPID 與數值;資料不足時直接說明需要哪些欄位或圖。回答精簡、條列重點。" />
  </appSettings>
  <connectionStrings>
    <!-- W/C source for GetWaferCounts. Server: UMCESIDB02 / DB: GPTDB_EAS.
         Adjust auth (Integrated Security vs User ID/Password) to match the deployment. -->
    <add name="GPTDB_EAS"
         connectionString="Server=UMCESIDB02;Database=GPTDB_EAS;Integrated Security=SSPI;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <!-- 50 MB request body / 2-min execution: base64 images can be big. -->
    <httpRuntime maxRequestLength="51200" executionTimeout="120" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
